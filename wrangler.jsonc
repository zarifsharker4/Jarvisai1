{
  "name": "mind-flayer",
  "main": "build/worker.js",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./build/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mind-flayer",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "vars": {
    "APP_ORIGIN": "http://localhost:3002",
    "APP_SECRET": "local-dev-only-secret-not-for-production",
    "APP_ENV": "local",
    // Replace with an address on the domain you verify with your mail provider.
    "MAIL_FROM": "Vecna from Mind Flayer <vecna@mindflayer.ai>"
  }
}
