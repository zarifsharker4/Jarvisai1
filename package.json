{
  "name": "Mind Flayer-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mind Flayer - full-stack multi-agent coding assistant on Cloudflare Workers",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:client": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && wrangler dev --port 3002",
    "preview": "wrangler dev --port 3002"
  },
  "dependencies": {
    "@freebuff/auth": "^0.1.0",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.151.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  }
}
